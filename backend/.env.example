MONGO_URI=
PORT=5011

# Comma-separated allowed frontend origins for CORS


STATEANDCITY_API_KEY=

# Optional — reverse geocode for travel / site-visit addresses (Google preferred, Nominatim fallback)
GOOGLE_MAPS_API_KEY=

# Meta / Google Ads lead webhooks (see routes/gamotechSolution/gamotechSolution_adsWebhookRoute.js)
# Callback URL: https://<host>/api/v1/gamotechSolution/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=multicrm-meta-verify
META_PAGE_ACCESS_TOKEN=
GAMOTECH_META_PAGE_ACCESS_TOKEN=
# OPTIONAL — leave ALL THREE empty to load every ad account your token can access (100+ clients).
# Use only ONE of the below if Graph /me/adaccounts fails:
# Single account:
META_AD_ACCOUNT_ID=
GAMOTECH_META_AD_ACCOUNT_ID=
# Many accounts (comma-separated act_ IDs):
META_AD_ACCOUNT_IDS=
GAMOTECH_META_AD_ACCOUNT_IDS=
GAMOTECH_ADS_LEAD_OWNER_EMAIL=
GAMOTECH_ADS_LEAD_OWNER_ID=
GOOGLE_ADS_WEBHOOK_KEY=
GAMOTECH_GOOGLE_ADS_WEBHOOK_KEY=
